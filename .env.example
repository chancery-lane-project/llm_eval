# LLM Provider API Keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=...
OPENROUTER_API_KEY=sk-or-v1-...

# Google Custom Search (for web search)
GOOGLE_SEARCH_API_KEY=...
GOOGLE_SEARCH_ENGINE_ID=...

# Database
DATABASE_URL=sqlite:///data/tclp_benchmark.db

# Logging
LOG_LEVEL=INFO

# TCLP Knowledge Graph MCP server (for the kg-mcp eval arm)
TCLP_MCP_URL=
# Optional — leave blank if the URL already carries auth as a query string
TCLP_MCP_TOKEN=
